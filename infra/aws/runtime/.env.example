# Copy to /opt/moodcafe/.env on EC2 and chmod 600. Never commit real secrets.
# Compose env_file accepts quotes; single-quote secrets containing $ to avoid interpolation.
DB_NAME=moodcafe
DB_USERNAME=moodcafe
DB_PASSWORD='CHANGE_ME_DATABASE_PASSWORD'

# Generate at least 64 random characters. Keep the existing secret if preserving tokens.
JWT_SECRET='CHANGE_ME_JWT_SECRET'
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7
JWT_ISSUER=mood_cafe
JWT_AUDIENCE=mood_cafe_users

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME_SMTP_USERNAME
SMTP_PASSWORD='CHANGE_ME_SMTP_APP_PASSWORD'
SMTP_FROM_EMAIL=CHANGE_ME_SMTP_FROM_EMAIL
SMTP_STARTTLS_ENABLE=true
SMTP_STARTTLS_REQUIRED=true
SMTP_ENABLE_SSL=false

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Set payment redirect URLs to the frontend's success/cancel pages if payments are used.
# PAYOS_RETURN_URL=https://your-frontend/payment/success
# PAYOS_CANCEL_URL=https://your-frontend/payment/cancel

COOKIE_SECURE=true

